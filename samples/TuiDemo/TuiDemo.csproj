<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MiniPty/MiniPty.csproj" />
    <ProjectReference Include="../../src/MiniPty.Console/MiniPty.Console.csproj" />
    <!-- Smoke checks interpret ConPTY's repaint stream with the existing sample emulator. -->
    <Compile Include="../TerminalEmulator/*.cs" Link="TerminalEmulator/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
