<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A separate process for PtyUnixDisposeTests: what happens to a disposed session's child when its host process
    exits can only be observed from outside that host. MiniPty.Tests copies this program next to itself.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MiniPty\MiniPty.csproj" />
  </ItemGroup>

</Project>
