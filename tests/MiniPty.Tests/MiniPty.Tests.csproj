<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <!-- LibraryImport stubs need it. Tests that drive the native spawn helper directly declare their own libc imports. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Opts the test host into long paths (see app.manifest); Windows only, and only where the machine allows them. -->
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- The out-of-band ConPTY the PtyConPtyTests load (see Directory.Packages.props); Windows only. -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\..\src\MiniPty\MiniPty.csproj" />
    <ProjectReference Include="..\..\src\MiniPty.Capture\MiniPty.Capture.csproj" />
    <ProjectReference Include="..\..\src\MiniPty.Console\MiniPty.Console.csproj" />
    <ProjectReference Include="..\..\src\MiniPty.Terminal\MiniPty.Terminal.csproj" />
  </ItemGroup>

  <!--
    The terminal emulator core shared by the WinUI and Avalonia samples has no UI dependency, so its sources are
    compiled here and tested on every platform (TerminalEmulatorTests). The GUI sample projects build only where
    their frameworks do.
  -->
  <ItemGroup>
    <Compile Include="..\..\samples\TerminalEmulator\*.cs" Link="TerminalEmulator\%(Filename)%(Extension)" />
    <Compile Include="..\..\samples\TuiDemo\DemoInput.cs" Link="TuiDemo\DemoInput.cs" />
    <Compile Include="..\..\samples\TuiDemo\DemoJobs.cs" Link="TuiDemo\DemoJobs.cs" />
    <Compile Include="..\..\samples\TuiDemo\DemoRenderer.cs" Link="TuiDemo\DemoRenderer.cs" />
  </ItemGroup>

  <!--
    OpenConsole.exe is staged beside conpty.dll by buildTransitive\MiniPty.ConPty.targets, which the repository's
    Directory.Build.targets imports into every project here, as the MiniPty package does for a package consumer.
  -->

</Project>
