<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>NativeAOT-friendly minimal cross-platform pseudo-terminal library.</Description>
    <MiniPtyPackUnixNative Condition="'$(MiniPtyPackUnixNative)' == ''">false</MiniPtyPackUnixNative>
    <_MiniPtyRuntimesRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\runtimes'))</_MiniPtyRuntimesRoot>
    <MiniPtyBuildUnixNative Condition="'$(MiniPtyPackUnixNative)' == 'true'">false</MiniPtyBuildUnixNative>
    <MiniPtyBuildUnixNative Condition="'$(MiniPtyBuildUnixNative)' == '' and ($([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX')) Or $([MSBuild]::IsOSPlatform('FreeBSD')))">true</MiniPtyBuildUnixNative>
    <MiniPtyUnixNativeLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libminipty_unix.dylib</MiniPtyUnixNativeLibraryName>
    <MiniPtyUnixNativeLibraryName Condition="'$(MiniPtyUnixNativeLibraryName)' == ''">libminipty_unix.so</MiniPtyUnixNativeLibraryName>
    <MiniPtyUnixNativeLinkFlags Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX')) Or $([MSBuild]::IsOSPlatform('FreeBSD'))">-lutil</MiniPtyUnixNativeLinkFlags>
    <MiniPtyUnixNativeLinkFlags Condition="'$(MiniPtyUnixNativeLinkFlags)' == ''"></MiniPtyUnixNativeLinkFlags>
    <_MiniPtyUnixNativeSources>$(MSBuildThisFileDirectory)Native/minipty_unix.c $(MSBuildThisFileDirectory)Native/minipty_unix_exec.c</_MiniPtyUnixNativeSources>
    <_MiniPtyUnixNativeOutput Condition="'$(MiniPtyBuildUnixNative)' == 'true'">$(OutputPath)$(MiniPtyUnixNativeLibraryName)</_MiniPtyUnixNativeOutput>
    <_MiniPtySpawnHelperOutput Condition="'$(MiniPtyBuildUnixNative)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">$(OutputPath)minipty_spawn_helper</_MiniPtySpawnHelperOutput>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MiniPty.Capture</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MiniPty.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MiniPty.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(MiniPtyPackUnixNative)' == 'true'">
    <None Include="$(_MiniPtyRuntimesRoot)\**\*.so;
                  $(_MiniPtyRuntimesRoot)\**\*.dylib"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Extensionless helper: set PackagePath to the destination directory only. -->
    <None Include="$(_MiniPtyRuntimesRoot)\osx-arm64\native\minipty_spawn_helper"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native" />
    <None Include="$(_MiniPtyRuntimesRoot)\osx-x64\native\minipty_spawn_helper"
          Pack="true"
          PackagePath="runtimes/osx-x64/native" />
  </ItemGroup>

  <Target Name="BuildMiniPtyUnixNative" BeforeTargets="AssignTargetPaths"
          Condition="'$(MiniPtyBuildUnixNative)' == 'true'">
    <MakeDir Directories="$(OutputPath)" Condition="!Exists('$(OutputPath)')" />
    <Exec Command="cc -shared -fPIC -O2 $(MiniPtyUnixNativeLinkFlags) -o &quot;$(_MiniPtyUnixNativeOutput)&quot; $(_MiniPtyUnixNativeSources)" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Command="cc -O2 -o &quot;$(_MiniPtySpawnHelperOutput)&quot; &quot;$(MSBuildThisFileDirectory)Native/minipty_spawn_helper.c&quot; &quot;$(MSBuildThisFileDirectory)Native/minipty_unix_exec.c&quot;" />
    <ItemGroup>
      <FileWrites Include="$(_MiniPtyUnixNativeOutput)" />
      <None Include="$(_MiniPtyUnixNativeOutput)">
        <Link>$(MiniPtyUnixNativeLibraryName)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <FileWrites Include="$(_MiniPtySpawnHelperOutput)" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <None Include="$(_MiniPtySpawnHelperOutput)" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <Link>minipty_spawn_helper</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

</Project>
